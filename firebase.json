{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/check-in/:id",
        "destination": "/check-in/[id]/index.html"
      },
      {
        "source": "/check-in/:id/:eventId",
        "destination": "/check-in/[id]/[eventId]/index.html"
      },
      {
        "source": "/register/:id",
        "destination": "/register/[id]/index.html"
      },
      {
        "source": "/contacts/:id",
        "destination": "/contacts/[id]/index.html"
      },
      {
        "source": "/groups/:id",
        "destination": "/groups/[id]/index.html"
      },
      {
        "source": "/live-activity/:id",
        "destination": "/live-activity/[id]/index.html"
      },
      {
        "source": "/co-enabler/:id",
        "destination": "/co-enabler/[id]/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
