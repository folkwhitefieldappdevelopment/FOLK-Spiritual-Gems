rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if a user has a specific role.
    function hasRole(role) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.hasAny([role]);
    }
    
    // Helper function to check if a user is an Admin.
    function isAdmin() {
      return hasRole('Admin');
    }

    // Helper function to check if a user is a Folk Guide.
    function isGuide() {
      return hasRole('Folk Guide');
    }
    
    // Helper function to check if a user is a Folk Enabler.
    function isEnabler() {
      return hasRole('Folk Enabler');
    }

    //----------------------------------------------------------------------
    // /users/{userId}
    //----------------------------------------------------------------------
    match /users/{userId} {
      // Allow user to read/update their own document.
      // Admins can read/write any user document.
      // Guides can read/update users that report to them.
      allow read: if request.auth.uid == userId 
                    || isAdmin() 
                    || (isGuide() && resource.data.reportsTo.guideId == request.auth.uid);
      
      allow create: if isAdmin() || isGuide();

      allow update: if request.auth.uid == userId 
                      || isAdmin() 
                      || (isGuide() && resource.data.reportsTo.guideId == request.auth.uid);
                      
      allow delete: if isAdmin();
    }

    //----------------------------------------------------------------------
    // /people/{personId}
    //----------------------------------------------------------------------
    match /people/{personId} {
      // Anyone authenticated can create a contact.
      allow create: if request.auth != null;
      
      // Read access:
      // - Admin can read all.
      // - Guide can read if person is assigned to them.
      // - Enabler can read if person is assigned or co-assigned to them.
      allow read: if isAdmin()
                  || (isGuide() && resource.data.folkGuideId == request.auth.uid)
                  || (isEnabler() && (resource.data.enablerInTouchWith == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name 
                                     || resource.data.coEnablerId == request.auth.uid));

      // Write access (Update/Delete):
      // - Admin can write all.
      // - Guide can write if person is assigned to them.
      // - Enabler can write if person is assigned or co-assigned to them.
      allow write: if isAdmin()
                   || (isGuide() && resource.data.folkGuideId == request.auth.uid)
                   || (isEnabler() && (resource.data.enablerInTouchWith == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name 
                                      || resource.data.coEnablerId == request.auth.uid));
    }
    
    //----------------------------------------------------------------------
    // /groups/{groupId}
    //----------------------------------------------------------------------
    match /groups/{groupId} {
      // Anyone can create a group for themselves.
      allow create: if request.auth.uid == request.resource.data.createdBy;

      // Read access:
      // - Admins can read all groups.
      // - User can read if they created it.
      // - User can read if their role is in the group's visibility list.
      allow read: if isAdmin() 
                  || resource.data.createdBy == request.auth.uid
                  || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.hasAny(resource.data.visibility);
                  
      // Write access:
      // - Admins can write all groups.
      // - User can write if they created it.
      allow write: if isAdmin() 
                   || resource.data.createdBy == request.auth.uid;
    }
    
    //----------------------------------------------------------------------
    // /settings/options
    //----------------------------------------------------------------------
    match /settings/options {
      // Only Admins can read and write global settings.
      allow read, write: if isAdmin();
    }
    
    //----------------------------------------------------------------------
    // /audits/{auditId}
    //----------------------------------------------------------------------
    match /audits/{auditId} {
        // Anyone can create an audit log.
        allow create: if request.auth != null;
        // Only Admins and Guides can read audit logs.
        allow read, list: if isAdmin() || isGuide();
        // Nobody can update or delete audit logs.
        allow update, delete: if false;
    }
  }
}
